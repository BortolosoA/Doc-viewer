# Doc Viewer - Environment Variables
# Copy this file to .env and adjust values as needed.

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=****
MINIO_ROOT_PASSWORD=****
MINIO_BUCKET=****

# PostgreSQL
POSTGRES_USER=****
POSTGRES_PASSWORD=****
POSTGRES_DB=****

# Default admin user (seeded automatically on server boot)
ADMIN_EMAIL=****
ADMIN_PASSWORD=****

# Frontend (injected at build time via Vite)
VITE_API_URL=http://localhost:3001

# JWT secret (change to a long random string in production)
JWT_SECRET=******

# Resend (email delivery)
RESEND_API_KEY=re_*************************
RESEND_FROM=onboarding@resend.dev

# Public base URL for verification links (frontend)
#APP_URL=http://localhost:5173
